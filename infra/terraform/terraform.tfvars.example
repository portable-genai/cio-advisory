# terraform.tfvars.example : concrete sample values for a Singapore-resident deploy.
#
# Copy to terraform.tfvars and fill in your own ids. Do NOT commit terraform.tfvars.
# Region/zone already default to Singapore; change them only together with allowed_regions.

project_id = "acme-wealth-sg-prod"

# Residency (P-03). The region is chosen at deploy time and validated against the
# allowlist; these are the secure defaults, shown for clarity. To deploy elsewhere you
# must set BOTH allowed_regions and region : that is the residency review point.
allowed_regions = ["asia-southeast1"]
region          = "asia-southeast1"
zone            = "asia-southeast1-a"

# Agent Search location of the house-view store. NOT the region: Agent Search serves only
# global, us and eu. The API must read the same value, so copy output house_views_api_env
# (CIO_HOUSE_VIEWS_LOCATION) into its environment. Where manage_org_policies is true this is
# also the second location group the stack's own gcp.resourceLocations admits.
house_views_location = "us"

# ~7-year WORM retention for the audit log (P-08). Bucket lock is irreversible.
retention_days = 2557

# Org / Access Context Manager. access_policy_id is the numeric policy id.
org_id           = "123456789012"
billing_account  = "01ABCD-2345EF-67890A"
access_policy_id = "987654321098"

# Networking for the private data plane.
vpc_network_name = "cio-advisory-vpc"

# Sovereignty perimeter on by default.
enable_vpc_sc = true

# WORM audit lock. NO default: every deployment names it. true is the compliant production
# posture and is IRREVERSIBLE for the retention window; false keeps the bucket destroyable.
worm_locked = true

# Shared-project declines. A deployment sharing its project with a stack that already owns the
# Org Policies, the data-access audit config and the perimeter declines all three, and a region
# that does not serve the malicious-URI filter narrows the guardrail (asia-southeast1 does not).
# The project's own policies must admit the house-view store's location (in:us-locations for
# the default) or the store is refused at apply:
# manage_org_policies           = false
# manage_audit_config           = false
# enable_vpc_sc                 = false
# model_armor_full_capabilities = false
#
# Embedding host: the portal's API runtime identity, filled after the portal apply mints it.
# additional_serving_service_accounts = ["journey-a-000000@acme-wealth-sg-prod.iam.gserviceaccount.com"]
