# B3 CIO Advisory Assistant : example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# Every var below is consumed by config/settings.yaml via ${VAR:-default} interpolation.
# The local/test profile needs NONE of the GCP-specific values : only CIO_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem.  'local' is a WORKING offline stack (SQLite FTS5 +
# deterministic LLM, no GCP SDK, no API key, no emulator) and is the dev/test default.
# 'onprem' fails fast (migration placeholders).
CIO_PROFILE=local

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Region is PINNED to asia-southeast1 in config/settings.yaml : not an env var.
# Do not add a region override here; residency depends on the pin.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/asia-southeast1/.../cryptoKeys/...)
# CIO_KMS_KEY=projects/your-project/locations/asia-southeast1/keyRings/cio/cryptoKeys/cio

# Toggle public-web grounding (the google_search sub-agent). true | false.
CIO_GROUNDING_ENABLED=false

# ---------------------------------------------------------------------------
# PII redaction : Sensitive Data Protection / DLP (gcp profile)
# ---------------------------------------------------------------------------
# CIO_DLP_INSPECT_TEMPLATE=projects/your-project/locations/asia-southeast1/inspectTemplates/replace-me
# CIO_DLP_DEIDENTIFY_TEMPLATE=projects/your-project/locations/asia-southeast1/deidentifyTemplates/replace-me

# ---------------------------------------------------------------------------
# Agent Runtime (set AFTER you deploy the reasoningEngine)
# ---------------------------------------------------------------------------
# CIO_AGENT_ENGINE=projects/your-project/locations/asia-southeast1/reasoningEngines/replace-me

# ---------------------------------------------------------------------------
# Platform sibling services (platform profile). Sensible localhost defaults apply.
# ---------------------------------------------------------------------------
# A2 governed knowledge base (CIO house-view retrieval).
KNOWLEDGE_BASE_URL=http://localhost:8082
# A1 guardrail gateway (guardrail screen + PII redaction).
GUARDRAIL_GATEWAY_URL=http://localhost:8080
# A3 agent registry.
AGENT_REGISTRY_URL=http://localhost:8083
# A4 AI quality / eval gate.
QUALITY_GATE_URL=http://localhost:8084
# A5 observability / audit.
OBSERVABILITY_URL=http://localhost:8085

# ---------------------------------------------------------------------------
# Human review hand-off (rule R8) : gcp / platform
# ---------------------------------------------------------------------------
# The human-review-console every escalated briefing is routed to. Under gcp the deployed console
# is an embedded app behind journey-portal's IAP edge, so HUMAN_REVIEW_URL is its edge path and
# HUMAN_REVIEW_IAP_AUDIENCE is the one bearer audience that edge accepts: the IAP OAuth client
# id, never the backend-service path. When the audience is set the router mints a fresh ID
# token for it per submission instead of sending S2S_TOKEN; unset keeps S2S_TOKEN; emptied
# refuses. Under gcp, review routing on needs BOTH (under platform, the URL); either missing
# refuses at boot, and CIO_REVIEW_ROUTING=off runs without routing.
# HUMAN_REVIEW_URL=https://rm.example.com/apps/human-review-console/api
# HUMAN_REVIEW_IAP_AUDIENCE=1234567890-fictionaledgeclient.apps.googleusercontent.com
# CIO_REVIEW_ROUTING=true

# ---------------------------------------------------------------------------
# Local profile (CIO_PROFILE=local) : SDK-free offline stores.
# ---------------------------------------------------------------------------
# Unset => per-package defaults under ~/.cio_advisory/. Use :memory: for ephemeral runs.
# CIO_LOCAL_DB=:memory:
# CIO_LOCAL_AUDIT=:memory:

# Optional higher-fidelity local: route the in-process stores to Google's official
# emulators when these are set AND the [gcp] extra is installed (client imported lazily,
# only on that branch). Unset => the default in-process / SQLite path (no google-cloud).
# FIRESTORE_EMULATOR_HOST=localhost:8080
# PUBSUB_EMULATOR_HOST=localhost:8085
# STORAGE_EMULATOR_HOST=localhost:9023

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# CIO_SETTINGS=config/settings.yaml
